{
    "name": "farhanchoksi/laravel-pretty-logger",
    "description": "Laravel Pretty Logger — a pretty_dio_logger style HTTP request/response logger for Laravel: colored, boxed terminal output (and a readable file log) with automatic secret masking.",
    "keywords": ["laravel", "logging", "http", "debug", "dio", "logger", "middleware"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Farhanchoksi",
            "email": "choksifarhan1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Farhanchoksi\\PrettyLogger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Farhanchoksi\\PrettyLogger\\PrettyLoggerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
